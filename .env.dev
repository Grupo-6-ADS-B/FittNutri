# ============================================================
# FittNutri — Variáveis de Ambiente para DESENVOLVIMENTO LOCAL
# ============================================================
# Valores INSEGUROS propositalmente — use APENAS localmente.
# Para produção, use .env.example como base e defina valores reais.
# Este arquivo NÃO deve ser commitado (coberto por *.env no .gitignore).
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=fittnutri
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- JWT (mínimo 32 chars) ---
JWT_SECRET=dev-jwt-secret-insecure-change-in-prod-min32
JWT_VALIDITY=86400000

# --- Criptografia AES (EXATAMENTE 32 caracteres) ---
APP_AES_KEY=dev-aes-key-32chars-insecure!!

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Resend (email transacional) ---
RESEND_API_KEY=re_-----------------------------
EMAIL_FROM=FittNutri <no-reply@fittnutri.site>

# --- AWS S3 (não necessário em dev — S3Config/@Profile("prod") não carrega) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- RabbitMQ (não necessário em dev — PdfConsumerService/@Profile("prod") não carrega) ---
RABBITMQ_URL=

# --- Grafana (não sobe no docker-compose.dev.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
