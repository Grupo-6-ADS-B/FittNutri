{
  "title": "FittNutri — API & Infraestrutura",
  "uid": "fittnutri-custom",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "America/Sao_Paulo",
  "tags": ["fittnutri", "api", "spring-boot"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Requisições HTTP",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taxa de requisições por endpoint (req/s)",
      "gridPos": { "x": 0, "y": 1, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\"}[5m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total de requisições (última hora)",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 2000 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"fittnutri\"}[1h]))",
          "legendFormat": "Requisições",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Endpoints ativos",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }
      },
      "targets": [
        {
          "expr": "count(count by (uri) (http_server_requests_seconds_count{application=\"fittnutri\"}))",
          "legendFormat": "Endpoints",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top endpoints — volume total (última hora)",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 500 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "topk(8, sum(increase(http_server_requests_seconds_count{application=\"fittnutri\"}[1h])) by (uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "Erros & Disponibilidade",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Taxa de erros por endpoint",
      "gridPos": { "x": 0, "y": 10, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps",
          "custom": { "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*5..*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          { "matcher": { "id": "byRegexp", "options": ".*4..*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\", status=~\"4..\"}[5m])) by (uri, status)",
          "legendFormat": "4xx {{uri}} ({{status}})",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\", status=~\"5..\"}[5m])) by (uri, status)",
          "legendFormat": "5xx {{uri}} ({{status}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Taxa de sucesso (última hora)",
      "gridPos": { "x": 16, "y": 10, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.95 },
            { "color": "green", "value": 0.99 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"fittnutri\", status=~\"2..\"}[1h])) / sum(increase(http_server_requests_seconds_count{application=\"fittnutri\"}[1h]))",
          "legendFormat": "Sucesso",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Erros 5xx (última hora)",
      "gridPos": { "x": 20, "y": 10, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": { "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"fittnutri\", status=~\"5..\"}[1h]))",
          "legendFormat": "Erros 5xx",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Erros por endpoint (última hora)",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": { "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "topk(6, sum(increase(http_server_requests_seconds_count{application=\"fittnutri\", status=~\"4..|5..\"}[1h])) by (uri, status))",
          "legendFormat": "{{uri}} {{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "Performance & Latência",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Latência P95 por endpoint",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"fittnutri\"}[5m])) by (uri, le))",
          "legendFormat": "P95 {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Latência média por endpoint",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{application=\"fittnutri\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{application=\"fittnutri\"}[5m])) by (uri)",
          "legendFormat": "AVG {{uri}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "Banco de Dados — HikariCP",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Conexões do pool (ativas / idle / pendentes)",
      "gridPos": { "x": 0, "y": 28, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Ativas" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          { "matcher": { "id": "byName", "options": "Idle" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          { "matcher": { "id": "byName", "options": "Pendentes" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          { "matcher": { "id": "byName", "options": "Máximo" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"fittnutri\"}",
          "legendFormat": "Ativas",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"fittnutri\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"fittnutri\"}",
          "legendFormat": "Pendentes",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_max{application=\"fittnutri\"}",
          "legendFormat": "Máximo",
          "refId": "D"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Utilização do pool (%)",
      "gridPos": { "x": 16, "y": 28, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"fittnutri\"} / hikaricp_connections_max{application=\"fittnutri\"}",
          "legendFormat": "Utilização",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Conexões ativas agora",
      "gridPos": { "x": 20, "y": 28, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": { "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 8 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"fittnutri\"}",
          "legendFormat": "Ativas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Tempo de aquisição de conexão (P95)",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "legend": { "displayMode": "list" } },
      "fieldConfig": {
        "defaults": { "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "red", "value": 0.5 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hikaricp_connections_acquire_seconds_bucket{application=\"fittnutri\"}[5m])) by (le))",
          "legendFormat": "P95 aquisição",
          "refId": "A"
        }
      ]
    },

    {
      "id": 40,
      "type": "row",
      "title": "Segurança — Login & Rate Limiting",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Taxa de tentativas de login",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Login OK (2xx)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          { "matcher": { "id": "byName", "options": "Login Falhou (401/403)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          { "matcher": { "id": "byName", "options": "Rate Limited (429)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\", uri=~\".*/login.*\", status=~\"2..\"}[5m]))",
          "legendFormat": "Login OK (2xx)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\", uri=~\".*/login.*\", status=~\"401|403\"}[5m]))",
          "legendFormat": "Login Falhou (401/403)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\", uri=~\".*/login.*\", status=\"429\"}[5m]))",
          "legendFormat": "Rate Limited (429)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Requisições bloqueadas (4xx) por endpoint",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"fittnutri\", status=~\"401|403|429\"}[5m])) by (uri, status)",
          "legendFormat": "{{uri}} ({{status}})",
          "refId": "A"
        }
      ]
    }
  ]
}
