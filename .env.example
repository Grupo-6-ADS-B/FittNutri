# ============================================================
# FittNutri — Variáveis de Ambiente (copiar para .env e preencher)
# NUNCA commitar o arquivo .env com valores reais
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=fittnutri
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_VALIDITY=86400000

# --- Criptografia AES (exatamente 32 caracteres) ---
APP_AES_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Resend (email transacional) ---
RESEND_API_KEY=
EMAIL_FROM=FittNutri <no-reply@fittnutri.com.br>

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- RabbitMQ (CloudAMQP) ---
RABBITMQ_URL=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
